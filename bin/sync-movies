#!/usr/bin/env python3
# pylint: disable=invalid-name
"""
Synchronise movie metadata between .nfo files and the Kodi API
"""
from abc import ABCMeta
import argparse
from datetime import datetime
import json
import os
import sys
import xml.etree.ElementTree as ET

# Straddle Python2/3
# to support py2 in older Kodi versions (<19)
# since v18 was the last to support MPEG2/VC1 hardware-acceleration on
# Raspberry Pi v3 boards.
try:
    from urllib.request import urlopen  # type: ignore
    from urllib.request import Request  # type: ignore
except ImportError:
    from urllib2 import urlopen  # type: ignore
    from urllib2 import Request  # type: ignore
try:
    from typing import Any, Dict, Iterable, Optional
except ImportError:
    pass


DEFAULT_HOST_ADDRESS = os.environ.get('KODI_HOST_ADDRESS', 'http://127.0.0.1')
DEFAULT_HOST_PORT = os.environ.get('KODI_HOST_PORT', '80')
DEFAULT_HOST_PATH = os.environ.get('KODI_HOST_PATH', 'jsonrpc')


def parse_types(data):  # type: (dict) -> dict
    """
    Parse string -> type within a dict
    """
    data = dict(data)
    for key, _type in (
        ('dateadded', parse_datetime),
        ('lastplayed', parse_datetime),
        ('playcount', parse_int),
    ):
        if key in data:
            try:
                data[key] = _type(data[key])  # type: ignore
            except TypeError:
                data[key] = None
    return data


def parse_int(string, default=0):  # type: (str, int) -> int
    """
    Convert a string into an integer
    """
    try:
        value = int(string)
    except TypeError:
        value = default
    return value


def parse_datetime(timestamp_string):  # type: (Optional[str]) -> Optional[datetime]
    """
    Parse a string into a datetime
    """
    if not timestamp_string:
        return None
    datetime_formats = (
        '%Y-%m-%d %H:%M:%S',
        '%Y-%m-%d %H:%M',
        '%Y-%m-%d',
    )
    for datetime_format in datetime_formats:
        try:
            timestamp = datetime.strptime(timestamp_string, datetime_format)
            return timestamp
        except ValueError:
            continue
    return None


DATA_TYPES = {
    'datetime': {
        'handler': parse_datetime,
        'keys': [
            'lastplayed',
            'dateadded',
        ],
    },
    'int': {
        'handler': parse_int,
        'keys': [
            'playcount',
            'year',
            'runtime',
        ],
    },
    'list': {
        'handler': None,
        'keys': [
            'genre',
            'tag',
            'director',
        ],
    },
    'str': {
        'handler': parse_int,
        'keys': [
            'title',
            'mpaa',
            'set',
            'tagline',
            'plot',
            'plotoutline',
            'trailer',
        ],
    },
}  # type: Dict[str, Dict[str, Any]]


class KodiApi:
    """
    Connect to and manage a Kodi instance via its API
    """

    def __init__(self, host, port, path):  # type: (str, str, str) -> None
        self.host = host
        self.port = port
        self.path = path
        self._headers = {
            'Cache-Control': 'no-cache',
            'Content-Type': 'application/json',
        }

    def call(self, data):  # type: (dict) -> Dict[str, Any]
        """
        Make a request to an endpoint with some data payload
        """
        if 'jsonrpc' not in data:
            data['jsonrpc'] = '2.0'
        if 'id' not in data:
            data['id'] = 'whatever'
        payload = json.dumps(data).encode()
        request_object = Request(
            self.url,
            data=payload,
            headers=self._headers,
        )
        with urlopen(request_object) as response:
            data = json.load(response)
        result = data.get('result', {})
        return result

    @property
    def url(self):  # type: () -> str
        """
        Build the API endpoint URL
        """
        url = "{host}:{port}/{path}".format(
            host=self.host,
            port=self.port,
            path=self.path,
        )
        return url


class NfoLibrary:
    """
    Define an nfo library for generic media
    """
    __metaclass__ = ABCMeta
    NFO_NAME_BASE = None  # type: str

    def __init__(self, root):  # type: (str) -> None
        root = os.path.abspath(root)
        self.root = root

    @classmethod
    def possible_nfos(cls, top, directory_name):  # type: (str, str) -> Iterable[str]
        """
        List all candidate nfo file pathnames within a directory
        """
        if cls is NfoLibrary:
            raise NotImplementedError
        possible_nfos = (
            # specific
            os.path.join(top, os.path.extsep.join([directory_name, 'nfo'])),
            # generic
            os.path.join(top, os.path.extsep.join([cls.NFO_NAME_BASE, 'nfo'])),
        )
        return possible_nfos

    @property
    def nfos(self):  # type: () -> Iterable[str]
        """
        Find all nfo metadata files within the library root
        """
        for nfo in self._walk():
            yield nfo

    def _walk(self, top=None):  # type: (str) -> Iterable[str]
        top = top or os.path.abspath(self.root)
        directory_name = os.path.basename(top)
        for possible_nfo in self.possible_nfos(top, directory_name):
            if os.path.exists(possible_nfo):
                yield possible_nfo
                return
        for _, dirs, _ in os.walk(top):
            for _dir in dirs:
                _dir = os.path.join(top, _dir)
                for nfo in self._walk(_dir):
                    yield nfo


class MovieNfoLibrary(NfoLibrary):
    """
    Define an nfo library for movie media
    """
    # pylint: disable=too-few-public-methods
    NFO_NAME_BASE = 'movie'


class Film:
    """
    Represent a movie within Kodi
    """

    def __init__(self, data, nfo=None):  # type: (dict, str) -> None
        self.data = data
        self.nfo = nfo or ''

    def __str__(self):  # type: () -> str
        string = str(self.data)
        return string

    @classmethod
    def _from_nfo_datetime(cls, data, movie_node):  # type: (dict, ET.Element) -> None
        for date_type in DATA_TYPES['datetime']['keys']:
            nodes = movie_node.findall('./' + date_type)
            item_date = None  # type: Optional[datetime]
            if len(nodes) > 0:
                node = nodes[0]
                item = node.text  # type: Optional[str]
                item_date = parse_datetime(item)
            data[date_type] = item_date

    @classmethod
    def _from_nfo_str(cls, data, movie_node):  # type: (dict, ET.Element) -> None
        for string_type in DATA_TYPES['str']['keys']:
            item = ''
            nodes = movie_node.findall('./' + string_type)
            if len(nodes) > 0:
                node = nodes[0]
                item = node.text or ''
            data[string_type] = item

    @classmethod
    def _from_nfo_int(cls, data, movie_node):  # type: (dict, ET.Element) -> None
        for int_type in DATA_TYPES['int']['keys']:
            nodes = movie_node.findall('./' + int_type)
            item = 0
            if len(nodes) > 0:
                node = nodes[0]
                try:
                    item = int(node.text or 0)
                except ValueError:
                    item = 0
            data[int_type] = item

    @classmethod
    def _from_nfo_list(cls, data, movie_node):  # type: (dict, ET.Element) -> None
        for list_type in DATA_TYPES['list']['keys']:
            nodes = movie_node.findall('./' + list_type)
            items = [
                node.text
                for node in nodes
                if node.text
            ]
            data[list_type] = items

    @classmethod
    def from_nfo(cls, nfo):  # type: (str) -> Optional[Film]
        """
        Parse an nfo file into a Film
        """
        tree = ET.parse(nfo)
        movie_node = cls._get_movie_node(tree)
        if movie_node is None:
            return None
        data = {}  # type: Dict[str, Any]
        cls._from_nfo_datetime(data, movie_node)
        cls._from_nfo_str(data, movie_node)
        cls._from_nfo_int(data, movie_node)
        cls._from_nfo_list(data, movie_node)
        film = cls(data, nfo=nfo)
        return film

    @classmethod
    def _get_movie_node(cls, tree):  # type: (ET.ElementTree) -> Optional[ET.Element]
        movie_nodes = tree.findall('.')
        movie_node = None
        if len(movie_nodes) == 1:
            movie_node = movie_nodes[0]
            if movie_node.tag != 'movie':
                movie_node = None
        return movie_node


def main():  # type: () -> None
    """
    Execute the script, presumably from the command line
    """
    args = parse_args()
    api = KodiApi(args.host_address, args.host_port, args.host_path)
    for path in args.paths:
        library = MovieNfoLibrary(path)
        for nfo in library.nfos:
            film = Film.from_nfo(nfo)
            if film:
                print(film, api)


def parse_args():  # type: () -> argparse.Namespace
    """
    Parse and process command-line arguments
    """
    script_name = os.path.split(sys.argv[0])[-1]
    description = __doc__
    parser = argparse.ArgumentParser(
        prog=script_name,
        description=description,
    )
    parser.add_argument(
        '-a',
        '--host-address',
        default=DEFAULT_HOST_ADDRESS,
    )
    parser.add_argument(
        '-p',
        '--host-port',
        default=DEFAULT_HOST_PORT,
    )
    parser.add_argument(
        '-P',
        '--host-path',
        default=DEFAULT_HOST_PATH,
    )
    parser.add_argument(
        '-n',
        '--noop',
        default=True,
        action='store_true',
    )
    parser.add_argument(
        '-N',
        '--no-noop',
        action='store_false',
        dest='noop',
    )
    parser.add_argument(
        '-l',
        '--local-update',
        default=True,
        action='store_true',
    )
    parser.add_argument(
        '-L',
        '--no-local-update',
        action='store_false',
        dest='local_update',
    )
    parser.add_argument(
        '-r',
        '--remote-update',
        default=True,
        action='store_true',
    )
    parser.add_argument(
        '-R',
        '--no-remote-update',
        action='store_false',
        dest='remote_update',
    )
    parser.add_argument(
        'paths',
        nargs='*',
        default=('.',),
    )
    args = parser.parse_args()
    return args


if __name__ == '__main__':
    main()
