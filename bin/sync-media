def _main_sync(args, cls_library):
    # type: (Dict[str, Any], Type[NfoLibrary]) -> None
    api = KodiApi(
        args['host_address'],
        args['host_port'],
        args['host_path'],
        username=args['username'],
        password=args['password'],
    )
    logger.debug("api: %s", api)
    for path in args['paths']:
        library = cls_library(path)
        for item in library.items():
            if item:
                item.sync(
                    api,
                    local_update=args['local_update'],
                    remote_update=args['remote_update'],
                    dry_run=args['noop'],
                )


def _ensure_app_directories_exist():  # type: () -> None
    """
    Create necessary application directories
    """
    for _dir in (CONFIG_HOME_APP, CACHE_HOME_APP):
        if not os.path.isdir(_dir):
            try:
                os.makedirs(_dir)
            except FileExistsError:
                pass


def format_datetime_rfc3339(self, record, datefmt=None):
    # type: (logging.Formatter, logging.LogRecord, Optional[str]) -> str
    """
    Format a datetime in RFC3339 format

    used for logging, which doesn't support fractional seconds, by default
    """
    # pylint: disable=unused-argument
    timestamp = datetime.fromtimestamp(record.created, tz=TZ_UTC)
    return (
        timestamp
        .astimezone(tz=TZ_LOCAL)  # type: ignore
        .isoformat()
    )


def main():  # type: () -> None
    """
    Execute the script from the command line
    """
    # DEBUG INFO WARNING ERROR CRITICAL
    _ensure_app_directories_exist()
    args = parse_args()
    logging.basicConfig(
        filename=CACHE_PATH_LOG,
        # TODO: Add this kwarg conditionally for PY3 only
        # encoding='utf-8',
        filemode='a',
        level=logging.INFO,
        format="%(asctime)s %(process)07d %(levelname)-8s %(module)s:%(funcName)s %(message)s",
    )
    setattr(logging.Formatter, 'formatTime', format_datetime_rfc3339)
    logger.debug("Loaded config: %s", args)
    cls_library = None  # type: Optional[Type[NfoLibrary]]
    if args['type'] == 'film':
        cls_library = MovieNfoLibrary
    elif args['type'] == 'show':
        cls_library = ShowNfoLibrary
    else:
        raise NotImplementedError(args['type'])
    _main_sync(args, cls_library)


def parse_args():  # type: () -> Dict[str, Any]
    """
    Parse and process configuration arguments

    CLI > ENV > JSON > DEFAULTS
    """
    script_name = os.path.split(sys.argv[0])[-1]
    description = __doc__
    parser = argparse.ArgumentParser(
        prog=script_name,
        description=description,
    )
    parser.add_argument(
        '-c',
        '--config',
        help='Path to JSON config file',
    )
    parser.add_argument(
        '-a',
        '--host-address',
    )
    parser.add_argument(
        '-p',
        '--host-port',
    )
    parser.add_argument(
        '-P',
        '--host-path',
    )
    parser.add_argument(
        '-u',
        '--username',
    )
    parser.add_argument(
        '-w',
        '--password',
    )
    parser.add_argument(
        '-n',
        '--noop',
        action='store_true',
        default=None,
    )
    parser.add_argument(
        '-N',
        '--no-noop',
        action='store_false',
        default=None,
        dest='noop',
    )
    parser.add_argument(
        '-l',
        '--local-update',
        action='store_true',
        default=None,
    )
    parser.add_argument(
        '-L',
        '--no-local-update',
        action='store_false',
        default=None,
        dest='local_update',
    )
    parser.add_argument(
        '-r',
        '--remote-update',
        action='store_true',
        default=None,
    )
    parser.add_argument(
        '-R',
        '--no-remote-update',
        action='store_false',
        default=None,
        dest='remote_update',
    )
    parser.add_argument(
        '-t',
        '--type',
        choices=(
            'film',
            'show',
        ),
    )
    parser.add_argument(
        'paths',
        nargs='*',
    )
    args = parser.parse_args()
    cli_settings = vars(args)
    env_settings = {
        key.lower()[len(CONFIG_ENV_PREFIX):]: value
        for key, value in os.environ.items()
        if key.startswith(CONFIG_ENV_PREFIX)
    }
    default_settings = {
        'config': CONFIG_PATH_JSON,
        'host_address': 'http://127.0.0.1',
        'host_port': 80,
        'host_path': 'jsonrpc',
        'noop': True,
        'local_update': True,
        'remote_update': True,
        'type': 'film',
        'paths': ('.',),
    }
    config_path = str(
        cli_settings['config']
        or env_settings.get('config')
        or default_settings['config']
    )
    with open(config_path, 'r', encoding='utf-8') as config_file:
        json_settings = json.load(config_file)
    join_settings = {
        key: value if value is not None else (
            env_settings.get(
                key,
                json_settings.get(
                    key,
                    default_settings.get(key)
                )
            )
        )
        for key, value in cli_settings.items()
    }
    return join_settings


if __name__ == '__main__':
    main()
