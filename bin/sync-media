#!/usr/bin/env python3
# pylint: disable=invalid-name
"""
Synchronise movie metadata between .nfo files and the Kodi API
"""
from abc import ABCMeta
import argparse
import base64
from copy import deepcopy
from datetime import datetime
from datetime import timedelta
import json
import os
import sys
import xml.etree.ElementTree as ET

# Straddle Python2/3
# to support py2 in older Kodi versions (<19)
# since v18 was the last to support MPEG2/VC1 hardware-acceleration on
# Raspberry Pi v3 boards.
try:
    from urllib.request import urlopen  # type: ignore
    from urllib.request import Request  # type: ignore
except ImportError:
    from urllib2 import urlopen  # type: ignore
    from urllib2 import Request  # type: ignore
try:
    from typing import Any, Dict, Iterable, List, Optional, Type
except ImportError:
    pass


def parse_types(data):  # type: (dict) -> dict
    """
    Parse string -> type within a dict
    """
    data = dict(data)
    for key, _type in (
        ('dateadded', parse_datetime),
        ('lastplayed', parse_datetime),
        ('playcount', parse_int),
    ):
        if key in data:
            try:
                data[key] = _type(data[key])  # type: ignore
            except TypeError:
                data[key] = None
    return data


def parse_int(_input, default=0):  # type: (Any, int) -> int
    """
    Convert a string into an integer
    """
    if hasattr(_input, 'text'):
        string = _input.text  # type: str
    else:
        string = str(_input)
    try:
        value = int(string)
    except (TypeError, ValueError):
        value = default
    return value


def parse_datetime(_input, default=None):  # type: (Any, Optional[datetime]) -> Optional[datetime]
    """
    Parse a string into a datetime
    """
    if _input is None:
        return default
    if hasattr(_input, 'text'):
        string = _input.text  # type: str
    else:
        string = str(_input)
    datetime_formats = (
        '%Y-%m-%d %H:%M:%S',
        '%Y-%m-%d %H:%M',
        '%Y-%m-%d',
    )
    for datetime_format in datetime_formats:
        try:
            timestamp = datetime.strptime(string, datetime_format)
            return timestamp
        except (TypeError, ValueError):
            continue
    return default


def parse_string(_input, default=''):  # type: (Any, str) -> str
    """
    Convert a string-like into an string
    """
    if hasattr(_input, 'text'):
        string = _input.text  # type: str
    else:
        string = _input
    try:
        value = str(string)
    except (TypeError, ValueError):
        value = default
    return value


def init_history_node(root_node):  # type: (ET.Element) -> ET.Element
    """
    Add and/or get a history node
    """
    history_nodes = root_node.findall('./history')
    if len(history_nodes) <= 0:
        history_node = ET.SubElement(root_node, 'history')
    else:
        history_node = history_nodes[0]
    return history_node


def add_to_history(root_node, lastplayed_text=None):  # type: (ET.Element, Optional[str]) -> None
    """
    Update the history node
    """
    if lastplayed_text is None:
        lastplayed_nodes = root_node.findall('./lastplayed')
        if len(lastplayed_nodes) > 0:
            lastplayed_node = lastplayed_nodes[0]
            lastplayed_text = lastplayed_node.text
    history_node = init_history_node(root_node)
    lastplayed_nodes = root_node.findall('./lastplayed')
    if lastplayed_text == '' or (lastplayed_text and lastplayed_text not in (
            _.text for _ in lastplayed_nodes
    )):
        _ = ET.SubElement(history_node, 'lastplayed')
        _.text = lastplayed_text


def update_playcount_history(root_node):  # type: (ET.Element) -> None
    """
    Backfill lastplayed entries in history, to match playcount
    """
    playcount_nodes = root_node.findall('./playcount')
    if len(playcount_nodes) > 0:
        playcount_node = playcount_nodes[0]
    else:
        playcount_node = ET.SubElement(root_node, 'playcount')
    playcount = parse_int(playcount_node, 0)
    lastplayed_nodes = root_node.findall('./history/lastplayed')
    count_lastplayed_nodes = len(lastplayed_nodes)
    history_node = init_history_node(root_node)
    while playcount > count_lastplayed_nodes:
        _ = ET.SubElement(history_node, 'lastplayed')
        count_lastplayed_nodes += 1


def indent(element, level=0, indent_size=4):  # type: (ET.Element, int, int) -> None
    """
    Indent the XML tree consistently
    """
    i = os.linesep + level * (' ' * indent_size)
    if len(element):
        if not element.text or not element.text.strip():
            element.text = i + (' ' * indent_size)
        if not element.tail or not element.tail.strip():
            element.tail = i
        for sub_element in element:
            indent(sub_element, level + 1, indent_size)
        # pylint: disable=undefined-loop-variable
        if not sub_element.tail or not sub_element.tail.strip():
            sub_element.tail = i
    else:
        if level and (not element.tail or not element.tail.strip()):
            element.tail = i


class KodiApi:
    """
    Connect to and manage a Kodi instance via its API
    """

    def __init__(self, host, port, path, username=None, password=None):
        # type: (str, str, str, Optional[str], Optional[str]) -> None
        # pylint: disable=too-many-arguments
        self.host = host
        self.port = port
        self.path = path
        self._headers = {
            'Cache-Control': 'no-cache',
            'Content-Type': 'application/json',
        }  # type: Dict[str, Any]
        if username:
            password = password or ''
            credentials = bytes((':'.join([username, password])).encode('utf-8'))
            authorization = 'Basic ' + base64.b64encode(credentials).decode('utf-8')
            self._headers['Authorization'] = authorization

    def call(self, data):  # type: (dict) -> Dict[str, Any]
        """
        Make a request to an endpoint with some data payload
        """
        if 'jsonrpc' not in data:
            data['jsonrpc'] = '2.0'
        if 'id' not in data:
            data['id'] = 'whatever'
        payload = json.dumps(data).encode()
        request_object = Request(
            self.url,
            data=payload,
            headers=self._headers,
        )
        with urlopen(request_object) as response:
            data = json.load(response)
        result = data.get('result', {})
        return result

    @property
    def url(self):  # type: () -> str
        """
        Build the API endpoint URL
        """
        url = "{host}:{port}/{path}".format(
            host=self.host,
            port=self.port,
            path=self.path,
        )
        return url


class NfoLibrary:
    """
    Define an nfo library for generic media
    """
    # pylint: disable=too-few-public-methods
    __metaclass__ = ABCMeta
    NFO_NAME_BASE = None  # type: str

    def __init__(self, root):  # type: (str) -> None
        root = os.path.abspath(root)
        self.root = root

    @classmethod
    def _possible_nfos(cls, top, directory_name):  # type: (str, str) -> Iterable[str]
        """
        List all candidate nfo file pathnames within a directory
        """
        if cls is NfoLibrary:
            raise NotImplementedError(
                "{cls} must be subclassed and should not be used directly".format(
                    cls=cls.__name__,
                )
            )
        if cls.NFO_NAME_BASE is None:
            raise NotImplementedError("{cls} must set {var} to a non-None value".format(
                cls=cls.__name__,
                var='NFO_NAME_BASE',
            ))
        _possible_nfos = (
            # specific
            os.path.join(top, os.path.extsep.join([directory_name, 'nfo'])),
            # generic
            os.path.join(top, os.path.extsep.join([cls.NFO_NAME_BASE, 'nfo'])),
        )
        return _possible_nfos

    def get_nfos(self, top=None):  # type: (str) -> Iterable[str]
        """
        Find all nfo metadata files within the library root
        """
        top = top or os.path.abspath(self.root)
        directory_name = os.path.basename(top)
        dirs, files = [], []
        for file_name in os.listdir(top):
            file_path = os.path.join(top, file_name)
            if os.path.isdir(file_path):
                dirs.append(file_path)
            elif os.path.isfile(file_path):
                if os.path.splitext(file_name)[-1].lower() == '.nfo':
                    files.append(file_path)
        for possible_nfo in self._possible_nfos(top, directory_name):
            # We must wait to check these until after the _entire_ file
            # listing is generated, since they are in order of
            # preference.
            if possible_nfo in files:
                yield possible_nfo
                # Once we find an nfo file in a directory, stop recursion.
                return
        for _dir in list(dirs):
            _dir = os.path.join(top, _dir)
            for nfo in self.get_nfos(_dir):
                yield nfo
        return

    @property
    def item_class(self):  # type: () -> Type[Media]
        """
        The object class used to instantiate items in this library
        """
        cls = type(self)
        if cls is NfoLibrary:
            raise NotImplementedError(
                "{cls} must be subclassed and the item_class property implemented".format(
                    cls=cls.__name__,
                )
            )
        return Media

    def items(self):  # type: () -> Iterable[Media]
        """
        Access all of the linked media objects in the library
        """
        for nfo in self.get_nfos():
            item = self.item_class.from_nfo(nfo)
            if item:
                yield item
            else:
                print("NO ITEM HERE", nfo)
                print('*' * 20)


class MovieNfoLibrary(NfoLibrary):
    """
    Define an nfo library for movie media
    """
    # pylint: disable=too-few-public-methods
    NFO_NAME_BASE = 'movie'

    @property
    def item_class(self):  # type: () -> Type[Film]
        """
        The object class used to instantiate items in this library
        """
        return Film


class ShowNfoLibrary(NfoLibrary):
    """
    Define an nfo library for TV show media
    """
    # pylint: disable=too-few-public-methods
    NFO_NAME_BASE = 'tvshow'

    @property
    def item_class(self):  # type: () -> Type[Show]
        """
        The object class used to instantiate items in this library
        """
        return Show


class Media:
    """
    Generic handling of Kodi library items
    """

    ROOT_NODE_TAG_NAME = None  # type: str
    API_METHOD_GET_ALL = None  # type: str
    API_METHOD_SET_ONE = None  # type: str
    API_METHOD_GET_RESULT_KEY = None  # type: str
    SHOULD_TOUCH_HISTORY_NODE = True
    ID_KEY = None  # type: str
    DATA_TYPES = {
        'datetime': {
            'default': None,
            'handler': parse_datetime,
            'keys': [
                'lastplayed',
                'dateadded',
            ],
        },
        'int': {
            'default': 0,
            'handler': parse_int,
            'keys': [
                'playcount',
                'year',
                'votes',
                # 'userrating',
                # 'rating', # TODO: float
            ],
        },
        'list': {
            'handler': None,
            'keys': [
                'genre',
                'studio',
                'tag',
            ],
        },
        'str': {
            'default': '',
            'handler': parse_string,
            'keys': [
                'title',
                'mpaa',
                'plot',
                'thumbnail',
                'file',
                'originaltitle',
                'sorttitle',
            ],
        },
        # cast
        # ratings
        # uniqueid
        # 'fanart',
        # 'art',
    }  # type: Dict[str, Dict[str, Any]]
    DATA_TYPES_EXTRA = {}  # type: Dict[str, Dict[str, Any]]
    DATA_TYPES_OMIT = []  # type: List[str]


    @classmethod
    def data_types(cls):  # type: () -> dict
        """
        Provide a mapping of all data types/attributes used by this
        media type
        """
        types = deepcopy(cls.DATA_TYPES)
        for key, value in types.items():
            types[key]['keys'] = [
                subkey
                for subkey in types[key]['keys']
                if subkey not in cls.DATA_TYPES_OMIT
            ]
        for key, value in cls.DATA_TYPES_EXTRA.items():
            types[key]['keys'].extend(value['keys'])
        return types

    def __init__(self, data, nfo=None, api_id=None):  # type: (dict, Optional[str], Optional[int]) -> None
        self.data = data
        self.nfo = nfo or ''
        self.api_id = api_id  # type: Optional[int]

    def __str__(self):  # type: () -> str
        string = str(self.data)
        return string

    @classmethod
    def _from_nfo_types(cls, data, root_node):  # type: (dict, ET.Element) -> None
        for key, _type in cls.data_types().items():
            if key == 'list':
                continue
            for attribute in _type['keys']:
                nodes = root_node.findall('./' + attribute)
                item = _type['default']  # type: Any
                if len(nodes) > 0:
                    node = nodes[0]
                    item = _type['handler'](node, _type['default'])
                data[attribute] = item

    @classmethod
    def _from_nfo_list(cls, data, root_node):  # type: (dict, ET.Element) -> None
        for list_type in cls.data_types()['list']['keys']:
            nodes = root_node.findall('./' + list_type)
            items = [
                node.text
                for node in nodes
                if node.text
            ]
            data[list_type] = items

    @classmethod
    def from_nfo(cls, nfo):  # type: (str) -> Optional[Media]
        """
        Parse an nfo file into a Media object
        """
        try:
            tree = ET.parse(nfo)
        except ET.ParseError as error:
            if error.msg.startswith('junk after document element:'):
                print("MULTI EPISODE FOUND", nfo)
                return None
            elif error.msg.startswith('syntax error:'):
                print("SYNTAX ERROR FOUND", nfo)
                return None
            else:
                print("NEW ERROR FOUND", error.msg, nfo)
                return None
            raise
        root_node = cls._get_root_node(tree)
        if root_node is None:
            return None
        data = {}  # type: Dict[str, Any]
        cls._from_nfo_types(data, root_node)
        cls._from_nfo_list(data, root_node)
        film = cls(data, nfo=nfo)
        return film

    @classmethod
    def _get_root_node(cls, tree):  # type: (ET.ElementTree) -> Optional[ET.Element]
        root_nodes = tree.findall('.')
        root_node = None
        if len(root_nodes) == 1:
            root_node = root_nodes[0]
            if root_node.tag != cls.ROOT_NODE_TAG_NAME:
                root_node = None
        return root_node

    @property
    def lookup_filter(self):  # type: () -> Dict[str, List[Dict[str, str]]]
        """
        Let subclasses override this filter to provide custom lookups
        """
        _filter = {
            'and': [
                {
                    'field': 'title',
                    'operator': 'is',
                    'value': self.data['title'],
                },
                {
                    'field': 'year',
                    'operator': 'is',
                    # TODO: fallback to premiered.split('-')[0]
                    'value': str(self.data['year']),
                },
            ],
        }
        return _filter

    @classmethod
    def from_api(cls, api, media):  # type: (KodiApi, Media) -> Optional[Media]
        """
        Parse an API response into a Media
        """
        if media:
            payload = {
                "method": cls.API_METHOD_GET_ALL,
                "params": {
                    'filter': media.lookup_filter,
                    'properties': [
                        # 'movieid',
                    ],
                },
            }  # type: Dict[str, Any]
            for _, value in cls.data_types().items():
                payload['params']['properties'].extend(value['keys'])
            result = api.call(payload)
            medias = result.get(cls.API_METHOD_GET_RESULT_KEY, [])
            if len(medias) < 1:
                print("NONE FOUND", media.data['title'], media.data.get('year'), media.nfo)
                print('*' * 20)
            elif len(medias) > 1:
                print("TOO MANY FOUND", media.data['title'], media.data.get('year'), media.nfo)
                for _media in medias:
                    print(_media)
                print('*' * 20)
            else:
                print("MATCH FOUND", media.data['title'], media.data.get('year'), media.nfo)
                data = medias[0]
                data = parse_types(data)
                api_id = data[cls.ID_KEY]
                media = cls(data, api_id=api_id)
            return media
        return None

    def _sync_dateadded(self, local, remote, nfo_changes, api_changes):
        # type: (Media, Media, dict, dict) -> None
        if local.data['dateadded'] and remote.data['dateadded']:
            # both sides have _some_ dateadded
            if (local.data['dateadded'] + timedelta(days=1)) < remote.data['dateadded']:
                # local is older, so update remote
                api_changes['dateadded'] = local.data['dateadded']
            elif (local.data['dateadded'] - timedelta(days=1)) > remote.data['dateadded']:
                # local is newer, so update local
                nfo_changes['dateadded'] = remote.data['dateadded']
        elif local.data['dateadded']:
            # only local side has dateadded, so set it remotely
            api_changes['dateadded'] = local.data['dateadded']
        elif remote.data['dateadded']:
            # only remote side has dateadded, so set it locally
            nfo_changes['dateadded'] = remote.data['dateadded']

    def _sync_lastplayed(self, local, remote, nfo_changes, api_changes):
        # type: (Media, Media, dict, dict) -> None
        if local.data['lastplayed'] and remote.data['lastplayed']:
            # both sides have _some_ lastplayed
            if (local.data['lastplayed'] - timedelta(days=1)) > remote.data['lastplayed']:
                # local is played more recently, so update remote
                if local.data['playcount'] > remote.data['playcount']:
                    # local is played more, so update api
                    api_changes['lastplayed'] = local.data['lastplayed']
            elif (local.data['lastplayed'] + timedelta(days=1)) < remote.data['lastplayed']:
                # remote is played more recently, so update local
                if local.data['playcount'] < remote.data['playcount']:
                    # local is played less, so update local
                    nfo_changes['lastplayed'] = remote.data['lastplayed']
        elif local.data['lastplayed']:
            # only local side has lastplayed, so set remote
            api_changes['lastplayed'] = local.data['lastplayed']
        elif remote.data['lastplayed']:
            # only remote side has lastplayed, so set local
            nfo_changes['lastplayed'] = remote.data['lastplayed']

    def _sync_playcount(self, local, remote, nfo_changes, api_changes):
        # type: (Media, Media, dict, dict) -> None
        if local.data['playcount'] > remote.data['playcount']:
            api_changes['playcount'] = local.data['playcount']
        elif local.data['playcount'] < remote.data['playcount']:
            nfo_changes['playcount'] = remote.data['playcount']

    def sync(self, api, local_update=False, remote_update=False, dry_run=True):
        # type: (KodiApi, bool, bool, bool) -> bool
        """
        Sync data between nfo files and the Kodi API
        """
        local = self
        remote = type(self).from_api(api, self)
        if self.api_id is None and remote is not None:
            self.api_id = remote.api_id
        if not remote:
            return False
        api_changes = {}  # type: Dict[str, Any]
        nfo_changes = {}  # type: Dict[str, Any]
        self._sync_dateadded(local, remote, nfo_changes, api_changes)
        self._sync_lastplayed(local, remote, nfo_changes, api_changes)
        self._sync_playcount(local, remote, nfo_changes, api_changes)
        cls = type(self)
        for list_type in cls.data_types()['list']['keys']:
            if sorted(local.data[list_type]) != sorted(remote.data[list_type]):
                api_changes[list_type] = local.data[list_type]
        for string_type in cls.data_types()['str']['keys']:
            if string_type == 'plotoutline':
                if local.data['plotoutline'] == local.data['plot']:
                    pass
                if local.data['plot'].startswith(local.data['plotoutline']):
                    pass
            else:
                if local.data[string_type] != remote.data[string_type]:
                    api_changes[string_type] = local.data[string_type]
        if 'lastplayed' in nfo_changes and 'playcount' not in nfo_changes:
            del nfo_changes['lastplayed']
        api_changes = {
            key: value
            for key, value in api_changes.items()
            if remote_update and key in (
                'dateadded',
                'genre',
                'lastplayed',
                'playcount',
                'tag',
                'title',
                'trailer',
            )
        }
        nfo_changes = {
            key: value
            for key, value in nfo_changes.items()
            if local_update and key in (
                'dateadded',
                'lastplayed',
                'playcount',
            )
        }
        if api_changes or nfo_changes:
            print(type(self).__name__.upper() + ':     ', local.data['title'])
        self.to_api(api, remote, api_changes, dry_run)
        self.to_nfo(self.nfo, local, nfo_changes, dry_run)
        if api_changes or nfo_changes:
            print('*' * 20)
        return bool(api_changes or nfo_changes)

    def to_api(self, api, remote, changes, dry_run):
        # type: (KodiApi, Media, dict, bool) -> bool
        """
        Send updates to the Kodi API
        """
        if not changes:
            return False
        print('API TO:   ', changes)
        print('API FROM: ', {
            key: value
            for key, value in remote.data.items()
            if key in changes
        })
        payload = {
            "method": self.API_METHOD_SET_ONE,
            "params": {
                self.ID_KEY: remote.data[self.ID_KEY],
            },
        }  # type: Dict[str, Any]
        for key, value in changes.items():
            payload['params'][key] = value
        print("PAYLOAD", payload)
        result = None
        if not dry_run:
            result = api.call(payload)
        return bool(result)

    def to_nfo(self, nfo, local, changes, dry_run):
        # type: (str, Media, dict, bool) -> None
        """
        Send updates to the nfo file
        """
        if not changes:
            return
        print('NFO TO:   ', changes)
        print('NFO FROM: ', {
            key: value
            for key, value in local.data.items()
            if key in changes
        })
        tree = ET.parse(nfo)
        root_node = self._get_root_node(tree)
        if root_node is None:
            return
        root = tree.getroot()
        if self.SHOULD_TOUCH_HISTORY_NODE:
            add_to_history(root_node)
        for key in changes.keys():
            node = root_node.findall('./' + key)
            if len(node) > 0:
                tag = node[0]
            else:
                print("Adding Missing Tag: ", key)
                tag = ET.SubElement(root_node, key)
            tag.text = str(changes[key])
            # tag.attrib['foo'] = 'bar'
        lastplayed_nodes = root_node.findall('./lastplayed')
        if self.SHOULD_TOUCH_HISTORY_NODE:
            if len(lastplayed_nodes) > 0:
                lastplayed_node = lastplayed_nodes[0]
                add_to_history(root_node, lastplayed_node.text)
            update_playcount_history(root_node)
        indent(root)
        if not dry_run:
            with open(nfo, 'wb') as nfo_out:
                nfo_out.write(b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n')
                tree.write(nfo_out, xml_declaration=False, encoding='utf-8')


class Show(Media):
    """
    Represent a movie within Kodi
    """
    ROOT_NODE_TAG_NAME = 'tvshow'
    API_METHOD_GET_ALL = 'VideoLibrary.GetTVShows'
    API_METHOD_SET_ONE = 'VideoLibrary.SetTVShowDetails'
    API_METHOD_GET_RESULT_KEY = 'tvshows'
    SHOULD_TOUCH_HISTORY_NODE = False
    ID_KEY = 'tvshowid'
    DATA_TYPES_EXTRA = {
        'datetime': {
            'keys': [
            ],
        },
        'int': {
            'keys': [
                'watchedepisodes',
                'episode',
                'season',
                ## rating: TODO float
            ],
        },
        'list': {
            'keys': [
            ],
        },
        'str': {
            'keys': [
                'premiered',
                # 'tagline',  # new(v22) on tvshow
                # 'plotoutline',  # mismatch?
                ## 'status',
            ],
        },
    }  # type: Dict[str, Dict[str, Any]]

    def __init__(self, data, nfo=None, api_id=None):  # type: (dict, Optional[str], Optional[int]) -> None
        if sys.version_info[0] == 2:
            # pylint: disable=super-with-arguments
            super(Show, self).__init__(data, nfo, api_id=api_id)
        else:
            super().__init__(data, nfo, api_id=api_id)


class Film(Media):
    """
    Represent a movie within Kodi
    """
    ROOT_NODE_TAG_NAME = 'movie'
    API_METHOD_GET_ALL = 'VideoLibrary.GetMovies'
    API_METHOD_SET_ONE = 'VideoLibrary.SetMovieDetails'
    API_METHOD_GET_RESULT_KEY = 'movies'
    ID_KEY = 'movieid'
    DATA_TYPES_EXTRA = {
        'datetime': {
            'keys': [
            ],
        },
        'int': {
            'keys': [
                'runtime',
                'top250',
            ],
        },
        'list': {
            'keys': [
                # 'director',
                # writer
            ],
        },
        'str': {
            'keys': [
                'set',
                'tagline',
                'plotoutline',
                'trailer',
                'country',
            ],
        },
    }  # type: Dict[str, Dict[str, Any]]

    def __init__(self, data, nfo=None):  # type: (dict, str) -> None
        if sys.version_info[0] == 2:
            # pylint: disable=super-with-arguments
            super(Film, self).__init__(data, nfo)
        else:
            super().__init__(data, nfo)


def _main_sync(args, cls_media, cls_library):
    # type: (argparse.Namespace, Type[Media], Type[NfoLibrary]) -> None
    api = KodiApi(
        args.host_address,
        args.host_port,
        args.host_path,
        username=args.username,
        password=args.password,
    )
    for path in args.paths:
        library = cls_library(path)
        for item in library.items():
            if item:
                item.sync(
                    api,
                    local_update=args.local_update,
                    remote_update=args.remote_update,
                    dry_run=args.noop,
                )


def main():  # type: () -> None
    """
    Execute the script from the command line
    """
    args = parse_args()
    cls_media = None  # type: Optional[Type[Media]]
    cls_library = None  # type: Optional[Type[NfoLibrary]]
    if args.type == 'film':
        cls_media = Film
        cls_library = MovieNfoLibrary
    elif args.type == 'show':
        cls_media = Show
        cls_library = ShowNfoLibrary
    else:
        raise NotImplementedError(args.type)
    _main_sync(args, cls_media, cls_library)


def parse_args():  # type: () -> argparse.Namespace
    """
    Parse and process command-line arguments
    """
    script_name = os.path.split(sys.argv[0])[-1]
    description = __doc__
    parser = argparse.ArgumentParser(
        prog=script_name,
        description=description,
    )
    parser.add_argument(
        '-a',
        '--host-address',
        default=os.environ.get('KODI_HOST_ADDRESS', 'http://127.0.0.1'),
    )
    parser.add_argument(
        '-p',
        '--host-port',
        default=os.environ.get('KODI_HOST_PORT', '80'),
    )
    parser.add_argument(
        '-P',
        '--host-path',
        default=os.environ.get('KODI_HOST_PATH', 'jsonrpc'),
    )
    parser.add_argument(
        '-u',
        '--username',
    )
    parser.add_argument(
        '-w',
        '--password',
    )
    parser.add_argument(
        '-n',
        '--noop',
        default=True,
        action='store_true',
    )
    parser.add_argument(
        '-N',
        '--no-noop',
        action='store_false',
        dest='noop',
    )
    parser.add_argument(
        '-l',
        '--local-update',
        default=True,
        action='store_true',
    )
    parser.add_argument(
        '-L',
        '--no-local-update',
        action='store_false',
        dest='local_update',
    )
    parser.add_argument(
        '-r',
        '--remote-update',
        default=True,
        action='store_true',
    )
    parser.add_argument(
        '-R',
        '--no-remote-update',
        action='store_false',
        dest='remote_update',
    )
    parser.add_argument(
        '-t',
        '--type',
        default='film',
        choices=(
            'film',
            'show',
        ),
    )
    parser.add_argument(
        'paths',
        nargs='*',
        default=('.',),
    )
    args = parser.parse_args()
    return args


if __name__ == '__main__':
    main()
