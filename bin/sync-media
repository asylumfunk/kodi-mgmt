        'sorttitle',
        'studio',
        'tag',
        'votes',   # ???
        'year',

        'thumbnail',
        'file',  # ???
    ]  # type: List[str]
    DATA_TYPES_EXTRA = {
        'datetime': {
            'keys': [
            ],
        },
        'int': {
            'keys': [
                'episode',
                'season',
                # 'displayepisode',  # mismatch
                # 'displayseason',  # mismatch
                'tvshowid',
                # 'seasonid', ???
                ## rating: TODO float
            ],
        },
        'list': {
            'keys': [
            ],
        },
        'str': {
            'keys': [
                # 'firstaired', ???
                # 'productioncode', ???
                'showtitle',
                # 'outline',
                # 'tagline',  # new(v22) on tvshow
                # 'plotoutline',  # mismatch?
                ## 'status',
            ],
        },
    }  # type: Dict[str, Dict[str, Any]]

    @property
    def lookup_filter(self):  # type: () -> Dict[str, List]
        _filter = {
            'and': [
                {
                    'field': 'tvshow',
                    'operator': 'is',
                    'value': str(self.data['showtitle']),
                },
                {
                    'field': 'episode',
                    'operator': 'is',
                    'value': str(self.data['episode']),
                },
                {
                    'field': 'season',
                    'operator': 'is',
                    'value': str(self.data['season']),
                },
            ],
        }
        return _filter


